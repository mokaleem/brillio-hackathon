{
  "version": 1,
  "imports": [
    {
      "name": "internal-agents",
      "kind": "agent",
      "type": "directory",
      "path": "internal_agents"
    },
    {
      "name": "internal-mcps",
      "kind": "mcp",
      "type": "directory",
      "path": "internal_mcps"
    },
    {
      "name": "internal-tools",
      "kind": "tool",
      "type": "directory",
      "path": "internal_tools"
    },
    {
      "name": "internal-skills",
      "kind": "skill",
      "type": "directory",
      "path": "internal_skills"
    }
  ],
  "extensions": [
    {
      "kind": "tool",
      "name": "html-report",
      "enabled": true,
      "source": "local",
      "entrypoint": "internal_tools.reporting:html_report",
      "description": "Generate a self-contained HTML report artifact",
      "tags": ["reporting", "artifact"],
      "risk_level": "low",
      "display_name": "HTML Report",
      "category": "Reporting",
      "metadata": {
        "group": "reporting"
      }
    },
    {
      "kind": "tool",
      "name": "csv-export",
      "enabled": true,
      "source": "local",
      "entrypoint": "internal_tools.reporting:csv_export",
      "description": "Generate a CSV artifact from structured JSON rows",
      "tags": ["reporting", "data"],
      "risk_level": "low",
      "display_name": "CSV Export",
      "category": "Reporting",
      "metadata": {
        "group": "reporting"
      }
    }
  ]
}
