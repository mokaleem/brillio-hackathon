# Copy to docker/hackathon-demo.env before running the split demo bundle.

HACKATHON_FRONTEND_PORT=3000
HACKATHON_GATEWAY_PORT=8001

# Demo defaults: same-origin UI server proxy to Gateway, with Gateway exposed
# directly for API docs and judges' inspection.
DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000
GATEWAY_CORS_ORIGINS=http://localhost:3000
GATEWAY_ENABLE_DOCS=true
DEER_FLOW_AUTH_DISABLED=1

# Runtime extension policy. Keep high-risk capabilities disabled unless the
# demo requires them and the operator has approved the action.
DEERFLOW_EXTENSION_MANIFESTS=registries/demo_extensions.json
DEERFLOW_EXTENSION_ALLOWED_RISK_LEVELS=low,medium
DEERFLOW_PYTHON_FUNCTION_ALLOWLIST=internal_tools.python_examples:summarize_metrics

# Override these when you want a checked-in example config replaced by local
# runtime config files. Relative paths are resolved from the docker/ directory.
DEER_FLOW_CONFIG_PATH=../config.example.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=../extensions_config.example.json

# Required for real model calls. Leave blank when running the no-LLM smoke
# checks, then provide a real value in your local untracked env file.
OPENAI_API_KEY=

# Required by NextAuth/Better Auth in production-like Next.js runtime.
BETTER_AUTH_SECRET=replace-with-a-long-random-demo-secret
